# Optional AI explanation provider.
# Leave unset for deterministic static-only review.
LLM_PROVIDER=

# watsonx.ai option
WATSONX_URL=
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Any OpenAI-compatible option
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Web server LLM toggle (default off — set to 1 to enable AI explanations in the web UI)
ENABLE_LLM_WEB=0
